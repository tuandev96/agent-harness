{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:agent-harness:runtime:1:run",
  "type": "object",
  "properties": {
    "contract": {
      "const": "harness-runtime/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "taskDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "profile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "candidate": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "sha256",
              "bytes"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": false
        },
        "runtime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "digest",
        "files",
        "runtime"
      ],
      "additionalProperties": false
    },
    "finishedCandidate": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "startedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "finishedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "CANCELLED",
        "TIMED_OUT",
        "UNKNOWN"
      ]
    },
    "exitCode": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIPPED",
              "CANCELLED"
            ]
          },
          "file": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "selector",
          "status",
          "file"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": false
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "truncated": {
      "type": "boolean"
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "producer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "invocationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "mode": {
          "const": "ASSISTED"
        }
      },
      "required": [
        "id",
        "sessionId",
        "invocationId",
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "contract",
    "id",
    "taskId",
    "taskDigest",
    "bindingId",
    "profile",
    "candidate",
    "finishedCandidate",
    "startedAt",
    "finishedAt",
    "outcome",
    "exitCode",
    "tests",
    "artifacts",
    "stdout",
    "stderr",
    "truncated",
    "reasonCodes",
    "producer"
  ],
  "additionalProperties": false
}
