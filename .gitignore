# Secrets
.credentials.yaml*
.anonymous-user-id
**/tokens.json

# Personal / runtime (never commit a ~/.dsh dump)
settings.yaml
settings.yaml.bak*
mcp-servers.json
guardian-ledger.jsonl
profiles/
erpipe-proxy/
sessions/
attachments/
storages/
*.log
/sessions-repair-backup-*/
/.backup-*/
/.evidence/
/engram-relay/
/super-injector/
/router-standard/

# Personal memory notes; keep INDEX.md only
memory/*
!memory/INDEX.md

# Dependencies
node_modules/
vendor/*
!vendor/dsh-mcp-settings/
!vendor/dsh-mcp-settings/**
!vendor/dsh-tool-arg-coerce/
!vendor/dsh-tool-arg-coerce/**
!vendor/dsh-replay-dedup/
!vendor/dsh-replay-dedup/**
vendor/dsh-mcp-settings/screenshots/
vendor/**/node_modules/
vendor/**/*.tgz
vendor/**/docs/verify-*.html

.DS_Store

# Built locally from the pinned toolchain; private runtime state is never source.
/dist/
/.harness/
/artifacts/
/coverage/

# Generated Python bytecode
__pycache__/
*.py[cod]

# Local verification artifacts are not distribution inputs
.harness-checks/

# Transient process exit markers, not verification evidence
plans/**/reports/*.exit
